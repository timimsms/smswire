require "test_helper"
require "webmock/minitest"

class <%= provider_class %>Test < ActiveSupport::TestCase
  include Smswire::TestHelper
  include Smswire::ProviderContract

  def contract_provider_name = :<%= file_name %>

  def contract_provider_options = {api_key: "test-key"}

  # Stub the provider API for each contract outcome. Update the error
  # payloads to the provider's real responses.
  def stub_contract_send(outcome, message)
    stub = stub_request(:post, <%= provider_class %>::API_URL)
    error = ->(status, code) { stub.to_return(status:, body: {error: {code:}}.to_json) }
    case outcome
    when :success
      stub.with(body: hash_including("to" => message.to, "body" => message.body))
        .to_return(status: 200, body: {id: "msg_1"}.to_json)
    when :invalid_number then error.call(400, "invalid_number")
    when :opted_out then error.call(400, "opted_out")
    when :authentication then stub.to_return(status: 401)
    when :throttled then stub.to_return(status: 429)
    when :server_error then stub.to_return(status: 503)
    when :timeout then stub.to_timeout
    end
  end
end
